# Flask dashboard authentication
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=replace_with_a_long_random_password
FLASK_SECRET_KEY=replace_with_a_long_random_secret

# Restrict Socket.IO origins. Example: http://192.168.1.50:5000
# Leave empty for same-origin behavior.
SOCKETIO_ALLOWED_ORIGINS=

# MQTT broker connection
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=desksense_app
MQTT_PASSWORD=replace_with_mqtt_password

# Set to true after configuring Mosquitto TLS certificates.
MQTT_TLS_ENABLED=false
MQTT_CA_CERT=/etc/mosquitto/certs/ca.crt
